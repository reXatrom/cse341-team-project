<%- include('./partials/header') %>

    <section class="trains-hero">
        <h1>Learn about our Trains</h1>
        <p>
            Explore the trains that power scenic trips across
            the Kizuna Rail network.
        </p>
    </section>

    <section class="trains-catalog">
        <form id="trains-filter-form" aria-label="Search and filter trains"
            style="display:flex;gap:14px;flex-wrap:wrap;align-items:end;margin:24px 0;">

            <div>
                <label for="trains-search">Search by name</label>
                <input type="search" id="trains-search" name="search" placeholder="Enter train name" maxlength="100">
            </div>

            <div>
                <label for="trains-operator">Operator</label>
                <select id="trains-operator" name="operator">
                    <option value="">All operators</option>
                    <option value="JR East">JR East</option>
                    <option value="JR West">JR West</option>
                    <option value="JR Hokkaido">JR Hokkaido</option>
                    <option value="Heritage Partnership">
                        Heritage Partnership
                    </option>
                </select>
            </div>

            <div>
                <label for="trains-type">Train type</label>
                <select id="trains-type" name="type">
                    <option value="">All types</option>
                    <option value="Limited Express">Limited Express</option>
                    <option value="Diesel Limited Express">
                        Diesel Limited Express
                    </option>
                    <option value="Steam Excursion">Steam Excursion</option>
                </select>
            </div>

            <div>
                <label for="trains-power">Power source</label>
                <select id="trains-power" name="powerSource">
                    <option value="">All power sources</option>
                    <option value="Electric">Electric</option>
                    <option value="Diesel">Diesel</option>
                    <option value="Steam">Steam</option>
                </select>
            </div>

            <button type="submit">Search Trains</button>
            <button type="button" id="trains-reset">
                Reset Filters
            </button>
        </form>

        <p id="trains-result-count" aria-live="polite"></p>

        <div class="trains-state" id="trains-loading">
            Loading trains...
        </div>

        <div class="trains-state trains-error" id="trains-error" role="alert" hidden></div>

        <div class="trains-grid" id="trains-list"></div>

        <nav class="trains-pagination" aria-label="Train pagination"
            style="display:flex;justify-content:center;align-items:center;gap:16px;margin:30px 0;flex-wrap:wrap;">
            <button type="button" id="trains-previous" disabled>
                Previous
            </button>

            <span id="trains-page-info" aria-live="polite">
                Page 1
            </span>

            <button type="button" id="trains-next" disabled>
                Next
            </button>
        </nav>

        <template id="train-card-template">
            <article class="train-card">
                <div class="train-image-wrap">
                    <img data-field="image" loading="lazy" decoding="async" alt="">
                </div>

                <header class="train-card-header">
                    <h2 data-field="name"></h2>
                    <span class="train-operator" data-field="operator"></span>
                </header>

                <p class="train-description" data-field="description"></p>

                <dl class="train-specs">
                    <div class="spec-item">
                        <dt>Type</dt>
                        <dd data-field="type"></dd>
                    </div>

                    <div class="spec-item">
                        <dt>Top Speed</dt>
                        <dd data-field="speed"></dd>
                    </div>

                    <div class="spec-item">
                        <dt>Capacity</dt>
                        <dd data-field="seats"></dd>
                    </div>

                    <div class="spec-item">
                        <dt>Power</dt>
                        <dd data-field="power"></dd>
                    </div>
                </dl>

                <p class="train-best-for">
                    <strong>Best For:</strong>
                    <span data-field="best-for"></span>
                </p>
            </article>
        </template>
    </section>

    <%- include('./partials/footer') %>