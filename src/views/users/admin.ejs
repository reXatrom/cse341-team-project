
<%- include('../partials/header') %>

<main class="container">
  <h1>User Management</h1>
  <p>View and manage user accounts.</p>

  <div id="users-message" role="status" aria-live="polite"></div>

  <section id="edit-user-section" hidden>
    <h2>Edit User</h2>

    <form id="edit-user-form">
      <input type="hidden" id="edit-user-id">

      <label for="edit-display-name">Display Name</label>
      <input type="text" id="edit-display-name" required>

      <label for="edit-username">Username</label>
      <input type="text" id="edit-username" required>

      <label for="edit-email">Email</label>
      <input type="email" id="edit-email" required>

      <button type="submit">Save Changes</button>
      <button type="button" id="cancel-edit">Cancel</button>
    </form>
  </section>

  <section id="users-container">
    <p>Loading users...</p>
  </section>
</main>

<script src="/js/users-admin.js" defer></script>

<%- include('../partials/footer') %>
