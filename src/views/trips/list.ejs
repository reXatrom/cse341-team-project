<%- include('../partials/header') %>

    <h1>
        <%= title %>
    </h1>

    <section aria-label="Trip search and filters">
        <div id="filters">
            <div>
                <label for="trip-search">Search Trips:</label>
                <input type="search" id="trip-search" placeholder="Search by trip name or description">
            </div>

            <div>
                <label for="region-filter">Search by Region:</label>
                <select id="region-filter">
                    <option value="">All Regions</option>
                    <% regions.forEach((region)=> { %>
                        <option value="<%= region %>">
                            <%= region.charAt(0).toUpperCase() + region.slice(1) %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <div>
                <label for="season-filter">Search by Season:</label>
                <select id="season-filter">
                    <option value="">Any Season</option>
                    <% seasons.forEach((season)=> { %>
                        <option value="<%= season %>">
                            <%= season.charAt(0).toUpperCase() + season.slice(1) %>
                        </option>
                        <% }); %>
                </select>
            </div>
        </div>
    </section>

    <p id="trip-status" role="status" aria-live="polite"></p>

    <div id="trips-container" class="routes-grid"></div>

    <nav id="trip-pagination" aria-label="Trip pagination" hidden>
        <button id="previous-page" type="button">
            Previous
        </button>

        <span id="page-information"></span>

        <button id="next-page" type="button">
            Next
        </button>
    </nav>

    <script src="/js/trips-list.js" defer></script>

    <%- include('../partials/footer') %>