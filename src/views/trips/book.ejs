<%- include('../partials/header') %>

    <article class="booking-page">
        <div class="route-header">
            <div class="route-header-content">
                <h1 class="route-name">
                    <%= title %>
                </h1>
                <p class="route-description">
                    Complete your booking details below.
                </p>
            </div>
        </div>

        <form class="booking-form" method="POST" action="/trips/book">
            <input type="hidden" name="scheduleId" value="<%= schedule.id %>">
            <input type="hidden" name="tripId" value="<%= schedule.tripId %>">

            <section class="ticket-selection">
                <h2 class="section-title">Select Your Ticket</h2>

                <div class="ticket-options">
                    <% if (ticketOptions && ticketOptions.length) { %>
                        <% ticketOptions.forEach((ticket, index)=> { %>
                            <label class="ticket-card" for="ticket-<%= ticket.class %>">
                                <input type="radio" name="ticketClass" id="ticket-<%= ticket.class %>"
                                    value="<%= ticket.class %>" data-name="<%= ticket.name %>"
                                    data-price="<%= ticket.price %>" <%=index===1 ? 'checked' : '' %>
                                required
                                >

                                <div class="ticket-content">
                                    <div class="ticket-header">
                                        <h3 class="ticket-name">
                                            <%= ticket.name %>
                                        </h3>

                                        <div class="ticket-price">
                                            <span class="price-symbol">¥</span>
                                            <span class="price-amount">
                                                <%= Number(ticket.price).toLocaleString() %>
                                            </span>
                                        </div>
                                    </div>

                                    <p class="ticket-description">
                                        <%= ticket.description %>
                                    </p>

                                    <ul class="amenities-list">
                                        <% if (ticket.amenities) { %>
                                            <% ticket.amenities.forEach((amenity)=> { %>
                                                <li class="amenity-item">
                                                    <span class="amenity-icon">✓</span>
                                                    <span class="amenity-text">
                                                        <%= amenity %>
                                                    </span>
                                                </li>
                                                <% }) %>
                                                    <% } %>
                                    </ul>
                                </div>
                            </label>
                            <% }) %>
                                <% } %>
                </div>
            </section>

            <section class="day-selection">
                <h2 class="section-title">Select The Day</h2>

                <div class="schedule-info">
                    <div class="time-display">
                        <span class="departure-time">
                            <%= schedule.departureTime %>
                        </span>
                        <span class="time-separator">→</span>
                        <span class="arrival-time">
                            <%= schedule.arrivalTime %>
                        </span>
                    </div>

                    <div class="days-display">
                        <% if (schedule && schedule.daysOfWeek) { %>
                            <% schedule.daysOfWeek.forEach((day, index)=> { %>
                                <label class="day-pill<%= index === 0 ? ' selected' : '' %>" for="day-<%= index %>">
                                    <input type="radio" name="selectedDay" id="day-<%= index %>" value="<%= day %>"
                                        <%=index===0 ? 'checked' : '' %>
                                    required
                                    >
                                    <span class="day-text">
                                        <%= day %>
                                    </span>
                                </label>
                                <% }) %>
                                    <% } %>
                    </div>
                </div>
            </section>

            <section class="passengers-section">
                <div class="passengers-header">
                    <h2 class="section-title">Passenger Details</h2>

                    <button type="button" class="btn-add-passenger" id="addPassenger">
                        <span class="add-icon">+</span>
                        Add Passenger
                    </button>
                </div>

                <div id="passengersList" class="passengers-list">
                    <div class="passenger-card" data-passenger-index="0">
                        <div class="passenger-card-header">
                            <h3 class="passenger-number">Passenger 1</h3>
                        </div>

                        <div class="form-grid">
                            <div class="form-group">
                                <label for="firstName-0" class="form-label">
                                    First Name
                                </label>
                                <input type="text" id="firstName-0" name="passengers[0][firstName]" class="form-input"
                                    required placeholder="Enter first name">
                            </div>

                            <div class="form-group">
                                <label for="lastName-0" class="form-label">
                                    Last Name
                                </label>
                                <input type="text" id="lastName-0" name="passengers[0][lastName]" class="form-input"
                                    required placeholder="Enter last name">
                            </div>

                            <div class="form-group">
                                <label for="email-0" class="form-label">
                                    Email Address
                                </label>
                                <input type="email" id="email-0" name="passengers[0][email]" class="form-input" required
                                    placeholder="your.email@example.com">
                            </div>

                            <div class="form-group">
                                <label for="phone-0" class="form-label">
                                    Phone Number
                                </label>
                                <input type="tel" id="phone-0" name="passengers[0][phone]" class="form-input" required
                                    placeholder="+81 90-1234-5678">
                            </div>
                        </div>
                    </div>
                </div>

                <p class="passenger-limit-note">
                    Maximum 8 passengers per online booking.
                    Please call to schedule larger groups.
                    (
                    <a href="#" id="autofill">
                        Click Here to Auto Fill Form
                    </a>
                    )
                </p>
            </section>

            <section class="booking-summary">
                <h2 class="section-title">Booking Summary</h2>

                <div class="summary-content">
                    <div class="summary-row">
                        <span class="summary-label">
                            Selected Ticket:
                        </span>
                        <span class="summary-value" id="selectedTicketName">
                            Select a ticket
                        </span>
                    </div>

                    <div class="summary-row">
                        <span class="summary-label">
                            Number of Passengers:
                        </span>
                        <span class="summary-value" id="passengerCount">
                            1
                        </span>
                    </div>

                    <div class="summary-row">
                        <span class="summary-label">
                            Price per Ticket:
                        </span>
                        <span class="summary-value" id="pricePerTicket">
                            ¥0
                        </span>
                    </div>

                    <div class="summary-row total">
                        <span class="summary-label">
                            Total Amount:
                        </span>
                        <span class="summary-value" id="totalAmount">
                            ¥0
                        </span>
                    </div>
                </div>
            </section>

            <div class="form-actions">
                <a href="/trips/<%= schedule.tripId %>" class="btn btn-secondary">
                    Cancel
                </a>

                <button type="submit" class="btn btn-primary">
                    Confirm Booking
                </button>
            </div>
        </form>
    </article>

    <script>
        const maxPassengers = 8;

        const passengersList = document.getElementById('passengersList');
        const addPassengerBtn = document.getElementById('addPassenger');
        const ticketRadios = document.querySelectorAll(
            'input[name="ticketClass"]'
        );
        const dayRadios = document.querySelectorAll(
            'input[name="selectedDay"]'
        );

        const selectedTicketName = document.getElementById(
            'selectedTicketName'
        );
        const passengerCountDisplay = document.getElementById(
            'passengerCount'
        );
        const pricePerTicket = document.getElementById(
            'pricePerTicket'
        );
        const totalAmount = document.getElementById(
            'totalAmount'
        );

        const getPassengerCards = () => {
            return Array.from(
                passengersList.querySelectorAll('.passenger-card')
            );
        };

        const getPassengerCount = () => {
            return getPassengerCards().length;
        };

        const formatPrice = (amount) => {
            return `¥${Number(amount).toLocaleString()}`;
        };

        const updateSummary = () => {
            const selectedTicket = document.querySelector(
                'input[name="ticketClass"]:checked'
            );

            const passengerCount = getPassengerCount();

            const ticketPrice = selectedTicket
                ? Number(selectedTicket.dataset.price) || 0
                : 0;

            selectedTicketName.textContent = selectedTicket
                ? selectedTicket.dataset.name
                : 'Select a ticket';

            passengerCountDisplay.textContent = passengerCount;

            pricePerTicket.textContent = formatPrice(ticketPrice);

            totalAmount.textContent = formatPrice(
                ticketPrice * passengerCount
            );
        };

        // Renumber every passenger card after adding or removing one.
        // This updates visible numbers, data attributes, input names,
        // input IDs, and matching label references.
        const updatePassengerNumbers = () => {
            const cards = getPassengerCards();

            cards.forEach((card, index) => {
                card.dataset.passengerIndex = String(index);

                const heading = card.querySelector(
                    '.passenger-number'
                );

                heading.textContent = `Passenger ${index + 1}`;

                const fields = [
                    'firstName',
                    'lastName',
                    'email',
                    'phone'
                ];

                fields.forEach((field) => {
                    const input = card.querySelector(
                        `[name$="[${field}]"]`
                    );

                    if (!input) {
                        return;
                    }

                    const newId = `${field}-${index}`;

                    input.id = newId;

                    input.name = `passengers[${index}][${field}]`;

                    const label = input.closest(
                        '.form-group'
                    )?.querySelector('label');

                    if (label) {
                        label.setAttribute('for', newId);
                    }
                });
            });
        };

        const createRemoveButton = () => {
            const button = document.createElement('button');

            button.type = 'button';
            button.className = 'btn-remove-passenger';
            button.setAttribute(
                'aria-label',
                'Remove passenger'
            );

            const icon = document.createElement('span');

            icon.className = 'remove-icon';
            icon.textContent = '×';

            button.appendChild(icon);

            return button;
        };

        const updateRemoveButtons = () => {
            const cards = getPassengerCards();

            cards.forEach((card) => {
                const header = card.querySelector(
                    '.passenger-card-header'
                );

                const existingButton = header.querySelector(
                    '.btn-remove-passenger'
                );

                if (cards.length === 1) {
                    existingButton?.remove();
                } else if (!existingButton) {
                    header.appendChild(
                        createRemoveButton()
                    );
                }
            });
        };

        const updateAddButtonState = () => {
            const atLimit = getPassengerCount() >= maxPassengers;

            addPassengerBtn.disabled = atLimit;

            addPassengerBtn.classList.toggle(
                'disabled',
                atLimit
            );
        };

        const refreshPassengerForm = () => {
            updatePassengerNumbers();
            updateRemoveButtons();
            updateAddButtonState();
            updateSummary();
        };

        const addPassenger = () => {
            const passengerCount = getPassengerCount();

            if (passengerCount >= maxPassengers) {
                alert(
                    `Maximum of ${maxPassengers} passengers allowed per booking`
                );
                return;
            }

            const passengerCard = document.createElement('div');

            passengerCard.className = 'passenger-card';

            passengerCard.innerHTML = `
            <div class="passenger-card-header">
                <h3 class="passenger-number">
                    Passenger ${passengerCount + 1}
                </h3>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">
                        First Name
                    </label>
                    <input
                        type="text"
                        class="form-input"
                        data-field="firstName"
                        required
                        placeholder="Enter first name"
                    >
                </div>

                <div class="form-group">
                    <label class="form-label">
                        Last Name
                    </label>
                    <input
                        type="text"
                        class="form-input"
                        data-field="lastName"
                        required
                        placeholder="Enter last name"
                    >
                </div>

                <div class="form-group">
                    <label class="form-label">
                        Email Address
                    </label>
                    <input
                        type="email"
                        class="form-input"
                        data-field="email"
                        required
                        placeholder="your.email@example.com"
                    >
                </div>

                <div class="form-group">
                    <label class="form-label">
                        Phone Number
                    </label>
                    <input
                        type="tel"
                        class="form-input"
                        data-field="phone"
                        required
                        placeholder="+81 90-1234-5678"
                    >
                </div>
            </div>
        `;

            // Assign initial names before the full renumbering.
            passengerCard.querySelectorAll('[data-field]').forEach(
                (input) => {
                    const field = input.dataset.field;

                    input.name = `passengers[${passengerCount}][${field}]`;
                }
            );

            passengersList.appendChild(passengerCard);

            refreshPassengerForm();
        };

        const removePassenger = (card) => {
            if (getPassengerCount() <= 1) {
                alert('At least one passenger is required');
                return;
            }

            card.remove();

            refreshPassengerForm();
        };

        const autoFillForm = () => {
            const westernFirstNames = [
                'James', 'Olivia', 'William', 'Emily',
                'Charlotte', 'George', 'Anna', 'Henry'
            ];

            const westernLastNames = [
                'Smith', 'Johnson', 'Brown', 'Taylor',
                'Wilson', 'Evans', 'Clark', 'Davis'
            ];

            const japaneseFirstNames = [
                'Yuki', 'Haruto', 'Sakura', 'Akira',
                'Hana', 'Kenji', 'Aoi', 'Takeshi'
            ];

            const japaneseLastNames = [
                'Tanaka', 'Suzuki', 'Yamamoto', 'Watanabe',
                'Ito', 'Nakamura', 'Kobayashi', 'Sato'
            ];

            const randomItem = (items) => {
                return items[Math.floor(Math.random() * items.length)];
            };

            const randomNumber = (min, max) => {
                return Math.floor(
                    Math.random() * (max - min + 1)
                ) + min;
            };

            getPassengerCards().forEach((card) => {
                const isJapanese = Math.random() < 0.3;

                const firstName = randomItem(
                    isJapanese
                        ? japaneseFirstNames
                        : westernFirstNames
                );

                const lastName = randomItem(
                    isJapanese
                        ? japaneseLastNames
                        : westernLastNames
                );

                const firstNameInput = card.querySelector(
                    '[name$="[firstName]"]'
                );
                const lastNameInput = card.querySelector(
                    '[name$="[lastName]"]'
                );
                const emailInput = card.querySelector(
                    '[name$="[email]"]'
                );
                const phoneInput = card.querySelector(
                    '[name$="[phone]"]'
                );

                firstNameInput.value = firstName;
                lastNameInput.value = lastName;

                emailInput.value =
                    `${firstName.toLowerCase()}.` +
                    `${lastName.toLowerCase()}` +
                    `${randomNumber(10, 99)}@example.com`;

                if (isJapanese) {
                    phoneInput.value =
                        `+81 120-${randomNumber(100, 999)}-` +
                        `${randomNumber(1000, 9999)}`;
                } else {
                    phoneInput.value =
                        `+44 1632 960${randomNumber(100, 999)}`;
                }
            });
        };

        // Add a passenger.
        addPassengerBtn.addEventListener(
            'click',
            addPassenger
        );

        // Remove a passenger using event delegation.
        passengersList.addEventListener('click', (event) => {
            const removeButton = event.target.closest(
                '.btn-remove-passenger'
            );

            if (!removeButton) {
                return;
            }

            const card = removeButton.closest(
                '.passenger-card'
            );

            if (card) {
                removePassenger(card);
            }
        });

        // Update ticket selection and price summary.
        ticketRadios.forEach((radio) => {
            radio.addEventListener('change', () => {
                updateSummary();
            });
        });

        // Update selected travel day styling.
        dayRadios.forEach((radio) => {
            radio.addEventListener('change', () => {
                document.querySelectorAll(
                    '.days-display .day-pill'
                ).forEach((label) => {
                    label.classList.toggle(
                        'selected',
                        label.querySelector('input').checked
                    );
                });
            });
        });

        // Fill the form with fictional test data.
        document.getElementById('autofill').addEventListener(
            'click',
            (event) => {
                event.preventDefault();
                autoFillForm();
            }
        );

        // Ensure sequential indexes immediately before submission.
        document.querySelector('.booking-form').addEventListener(
            'submit',
            () => {
                updatePassengerNumbers();
            }
        );

        // Initialize the form.
        refreshPassengerForm();
    </script>

    <%- include('../partials/footer') %>